    "# Keep only the 10 biggest categories; group the rest as \"Other\" so we do not create 50 columns\n",
    "top_categories = clean_df[\"category\"].value_counts().head(10).index\n",
    "model_df = clean_df.copy()\n",
    "model_df[\"category_group\"] = model_df[\"category\"].where(model_df[\"category\"].isin(top_categories), \"Other\")\n",
    "\n",
    "# Turn category into 0/1 columns\n",
    "category_dummies = pd.get_dummies(model_df[\"category_group\"], drop_first=True)\n",
    "\n",
    "X = pd.concat([model_df[[\"rating_num\", \"quantity\", \"title_length\", \"description_length\"]],\n",
    "               category_dummies], axis=1).astype(float)\n",
    "y = model_df[\"price\"]\n",
    "\n",
    "print(\"Features shape:\", X.shape)\n",
    "X.head()"
   ]
  },
