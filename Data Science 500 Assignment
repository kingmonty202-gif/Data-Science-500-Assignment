    "# Step 2: visit every book's own page for extra details\n",
    "for i in range(len(books)):\n",
    "    book = books[i]\n",
    "    response = requests.get(book[\"link\"])\n",
    "    response.encoding = \"utf-8\"\n",
    "    soup = BeautifulSoup(response.text, \"html.parser\")\n",
    "\n",
    "    # category = 3rd link in the breadcrumb: Home > Books > Category > Title\n",
    "    crumbs = soup.find(\"ul\", class_=\"breadcrumb\").find_all(\"a\")\n",
    "    book[\"category\"] = crumbs[2].text.strip()\n",
    "\n",
    "    # stock text on the book page looks like \"In stock (22 available)\"\n",
    "    stock_tag = soup.find(\"p\", class_=\"instock availability\")\n",
    "    book[\"stock_text\"] = stock_tag.text.strip() if stock_tag else None\n",
    "\n",
    "    # description is the paragraph that follows the 'product_description' heading (some books have none)\n",
    "    desc_div = soup.find(\"div\", id=\"product_description\")\n",
    "    if desc_div is not None:\n",
    "        book[\"description\"] = desc_div.find_next_sibling(\"p\").text.strip()\n",
    "    else:\n",
    "        book[\"description\"] = None\n",
    "\n",
    "    if (i + 1) % 100 == 0:\n",
    "        print(\"Done\", i + 1, \"of\", len(books))\n",
    "    time.sleep(0.1)\n",
    "\n",
    "raw_df = pd.DataFrame(books)\n",
    "raw_df.to_csv(\"raw_books.csv\", index=False)          # save the RAW data\n",
    "print(\"Saved raw_books.csv with\", len(raw_df), \"rows\")\n",
    "raw_df.head()"
   ]
  },
